generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id               String            @id @default(uuid())
  email            String            @unique @db.VarChar(255)
  password         String?
  role             role_enum         @default(participant)
  full_name        String            @db.VarChar(255)
  bio              String?
  photo_url        String?
  external_links   Json?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  deleted_at       DateTime?
  audit_logs       audit_log[]
  refresh_tokens   refreshToken[]
  session_speakers session_speaker[]
}

model refreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  created_at DateTime @default(now())
  expires_at DateTime
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model room {
  id       String    @id @default(uuid())
  name     String    @db.VarChar(50)
  sessions session[]
}

model event {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(255)
  description String?
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  location    String?   @db.VarChar(255)
  sessions    session[]
}

model session {
  id          String            @id @default(uuid())
  title       String            @db.VarChar(255)
  description String?
  start_time  DateTime          @db.Timestamp(6)
  end_time    DateTime          @db.Timestamp(6)
  capacity    Int?
  event_id    String
  room_id     String
  questions   question[]
  event       event             @relation(fields: [event_id], references: [id], onDelete: Cascade)
  room        room              @relation(fields: [room_id], references: [id])
  speakers    session_speaker[]
}

model session_speaker {
  id         Int     @id @default(autoincrement())
  session_id String
  speaker_id String
  session    session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  speaker    user    @relation(fields: [speaker_id], references: [id], onDelete: Cascade)

  @@unique([session_id, speaker_id])
}

model question {
  id          String   @id @default(uuid())
  content     String
  author_name String?  @default("anonymous") @db.VarChar(255)
  upvotes     Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  session_id  String
  session     session  @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model audit_log {
  id          Int          @id @default(autoincrement())
  user_id     String
  action      audit_action
  entity_type entity_type
  entity_id   String
  old_data    Json?
  new_data    Json?
  created_at  DateTime     @default(now())
  user        user         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum role_enum {
  admin
  speaker
  participant
}

enum audit_action {
  create
  update
  delete
}

enum entity_type {
  room
  session
  event
  question
  user
}
